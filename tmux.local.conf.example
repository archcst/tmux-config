# Optional machine- and user-specific settings.
# Copy this file to tmux.local.conf and uncomment what you need.

# Prefix key (default: C-b).
# set -g @prefix 'C-a'

# Network probe used by tmux-online-status (default: www.google.com).
# set -g @route_to_ping "1.1.1.1"

# Optional screen saver command. This is not an authentication lock.
# set -g lock-command 'cmatrix -s'
# set -g lock-after-time 600

# Restore Neovim sessions with tmux-resurrect.
# set -g @resurrect-strategy-nvim 'session'

# pi-focus-bell integration: pi install npm:pi-focus-bell
# set-hook -g after-select-pane 'set-option -p @pi_bell 0'
# set-hook -g after-select-window 'set-option -p @pi_bell 0'

# macOS: switch to English when selecting a pane or changing the current window.
# Requires macime: brew install riodelphino/tap/macime
# Adjust the executable path and input source ID for your machine (macime list).
# Hook index 100 preserves the pi-focus-bell hooks above.
# set-hook -g 'after-select-pane[100]' 'run-shell "/opt/homebrew/bin/macime set com.apple.keylayout.ABC"'
# set-hook -g 'session-window-changed[100]' 'run-shell "/opt/homebrew/bin/macime set com.apple.keylayout.ABC"'

# Optional black-on-green titles for panes marked by pi-focus-bell.
# Border colors indicate focus.
# set -g pane-border-format "#{?#{==:#{@pi_bell},1},#[bg=#{@thm_green}]#[fg=#000000]#[bold],#[bg=default]#{?pane_active,#[fg=#{@thm_peach}]#[bold],#[fg=#{@thm_surface_2}]#[nobold]}} #P. #{s|^π - ||:#{s|^.*@[^ ]* ||:#{pane_title}}} #[default]"
